<?xml version="1.0"?>
<ruleset name="Cron Doctor">
	<description>WordPress Coding Standards and PHP compatibility for wp-cron-doctor.</description>

	<file>command.php</file>
	<file>wp-cron-doctor.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>src</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="5.7"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Classes are autoloaded with PSR-4, so file names follow class names. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!-- src/ is pure PHP that never prints HTML, and the WP-CLI command passes exception messages to the terminal only. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/includes/Command\.php</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-cron-doctor"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wp_cron_doctor"/>
				<element value="Saizul\CronDoctor"/>
			</property>
		</properties>
	</rule>
</ruleset>
